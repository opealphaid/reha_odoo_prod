<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pagos anticipados (Fase 2): reintenta register-payment en las
         reservas pagadas en el POS cuya notificación al backend falló. -->
    <data noupdate="1">
        <record id="ir_cron_rehalife_retry_backend_payment" model="ir.cron">
            <field name="name">Rehalife: reintentar notificación de pagos al backend</field>
            <field name="model_id" ref="model_rehalife_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_backend_payment()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="rehalife_o18.ReservationDialog">
    <Dialog title="'Reservas Pendientes de Cobro'" size="'xl'">

      <div>
        <!-- ── Sucursal del recepcionista (solo usuarios restringidos) ── -->
        <div t-if="state.branchInfo.restricted and state.branchInfo.branch_name"
             class="mb-2 fw-bold">
          <i class="fa fa-building me-1"/>
          Sucursal: <t t-esc="state.branchInfo.branch_name"/>
        </div>

        <!-- ── Barra de búsqueda ── -->
        <div class="d-flex gap-2 mb-3 p-2 bg-light rounded">
          <div class="input-group">
            <span class="input-group-text">
              <i class="fa fa-user"/>
            </span>
            <input type="text"
                   class="form-control"
                   placeholder="Buscar por paciente..."
                   t-model="state.searchName"/>
          </div>
          <!-- Oculto para el recepcionista restringido: solo ve su sucursal. -->
          <div class="input-group" t-if="!state.branchInfo.restricted">
            <span class="input-group-text">
              <i class="fa fa-building"/>
            </span>
            <input type="text"
                   class="form-control"
                   placeholder="Buscar por sucursal..."
                   t-model="state.searchBranch"/>
          </div>
          <button class="btn btn-outline-secondary"
                  t-on-click="() => { state.searchName = ''; state.searchBranch = ''; }"
                  title="Limpiar filtros">
            <i class="fa fa-times"/>
          </button>
        </div>

        <!-- ── Contenido: Reservas ── -->
        <div style="max-height:460px; overflow-y:auto;">

          <div t-if="state.loading" class="text-center p-5">
            <div class="spinner-border text-primary" role="status"/>
            <p class="mt-2">Cargando reservas...</p>
          </div>

          <div t-elif="noBranchAssigned" class="alert alert-warning m-3" role="alert">
            <i class="fa fa-exclamation-triangle me-1"/>
            Tu usuario no tiene una sucursal asignada. Pide al administrador que
            configure tu Sucursal SIAT y su Sucursal Rehalife.
          </div>

          <div t-elif="filteredReservations.length === 0"
               class="text-center p-5 text-muted">
            <i class="fa fa-search fa-3x mb-3"/>
            <p t-if="state.searchName or state.searchBranch">
              No se encontraron reservas con ese filtro.
            </p>
            <p t-else="">No hay reservas pendientes de cobro.</p>
          </div>

          <table t-else="" class="table table-hover table-sm mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th>Paciente</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Servicio</th>
                <th>Precio</th>
                <th>Sucursal</th>
                <th>Consultorio</th>
                <th>Paciente Paga</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="filteredReservations" t-as="res" t-key="res.id">
                <tr t-att-class="isAdded(res) ? 'table-warning' : ''">
                  <td><strong><t t-esc="res.partner_id[1]"/></strong></td>
                  <td><t t-esc="res.reservation_date"/></td>
                  <td>
                    <t t-esc="res.reservation_time || '—'"/>
                    <t t-if="res.end_time"> – <t t-esc="res.end_time"/></t>
                  </td>
                  <td>
                    <t t-esc="res.service_type_name || '—'"/>
                    <t t-set="badge" t-value="serviceBadge(res)"/>
                    <span t-if="badge" t-att-class="badge.cls + ' ms-1'"
                          t-att-title="serviceInfo(res).message || badge.label">
                      <t t-esc="badge.label"/>
                    </span>
                  </td>
                  <td>
                    <t t-if="servicePrice(res) !== null"><t t-esc="servicePrice(res).toFixed(2)"/> Bs.</t>
                    <t t-else="">—</t>
                  </td>
                  <td><t t-esc="res.branch_name || '—'"/></td>
                  <td><t t-esc="res.environment_name || '—'"/></td>
                  <td>
                    <t t-if="res.modalidad === 'seguro'">
                      <t t-esc="res.monto_a_pagar_paciente.toFixed(2)"/> Bs.
                      <span t-if="!res.monto_cobertura_seguro" class="badge bg-warning text-dark ms-1"
                            title="Sin Cobertura configurada para esta aseguradora/servicio">
                        ⚠️ sin cobertura
                      </span>
                    </t>
                    <t t-elif="servicePrice(res) !== null"><t t-esc="servicePrice(res).toFixed(2)"/> Bs.</t>
                    <t t-else="">—</t>
                  </td>
                  <td>
                    <span t-if="isAdded(res)" class="badge bg-success me-1">
                      ✓ Ya agregada
                    </span>
                    <button t-att-class="isAdded(res) or !canCharge(res) ? 'btn btn-outline-secondary btn-sm' : 'btn btn-primary btn-sm'"
                            t-att-disabled="!canCharge(res)"
                            t-att-title="canCharge(res) ? '' : serviceInfo(res).message"
                            t-on-click="() => this.selectReservation(res)">
                      Cobrar
                    </button>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>

        </div>

        <!-- ── Contador ── -->
        <div class="text-muted text-end small pt-2 pe-1"
             t-if="!state.loading">
          <t t-esc="filteredReservations.length"/> de
          <t t-esc="state.reservations.length"/> reservas
        </div>
      </div>

    </Dialog>
  </t>

  <!-- ── Botón en ProductScreen ── -->
  <t t-name="rehalife_o18.ReservationButton"
     t-inherit="point_of_sale.ProductScreen"
     t-inherit-mode="extension">
    <xpath expr="//div[hasclass('leftpane')]" position="before">
      <button class="btn btn-warning px-4 py-2 fw-bold"
              style="position:fixed;bottom:80px;right:20px;z-index:100;border-radius:8px;"
              t-on-click="openReservations">
        Reservas
      </button>
    </xpath>
  </t>

</templates>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_rehalife_seguros" model="ir.ui.view">
        <field name="name">account.move.form.rehalife.seguros</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_notas_conformidad"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="nota_conformidad_count == 0">
                    <field name="nota_conformidad_count" widget="statinfo" string="Notas Conformidad"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rehalife_seguros_sync_wizard_form" model="ir.ui.view">
        <field name="name">rehalife.seguros.sync.wizard.form</field>
        <field name="model">rehalife.seguros.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Configuración Seguros">
                <sheet>
                    <div class="app_settings_block">
                        <h2>Sincronización con Backend Rehalife</h2>
                        <div class="text-muted mb-3">
                            Usa la misma conexión configurada en Rehalife &gt; Configuración.
                        </div>
                        <div class="row mt16 o_settings_container">

                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Aseguradoras</span>
                                    <div class="text-muted">
                                        Importa/actualiza las aseguradoras desde el backend.
                                        Las nuevas se crean con NIT placeholder "0000000"
                                        (el backend no maneja NIT) — corrígelo antes de
                                        facturarles de verdad.
                                    </div>
                                    <div class="mt8">
                                        <button string="Sincronizar Aseguradoras"
                                                name="action_sync_insurance_providers"
                                                type="object"
                                                class="btn btn-secondary"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Pacientes Asegurados</span>
                                    <div class="text-muted">
                                        Actualiza la aseguradora de cada paciente según sus
                                        afiliaciones en el backend (solo considera
                                        aseguradoras ya sincronizadas en Odoo).
                                    </div>
                                    <div class="mt8">
                                        <button string="Sincronizar Pacientes Asegurados"
                                                name="action_sync_patient_insurances"
                                                type="object"
                                                class="btn btn-secondary"/>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rehalife_seguros_sync_wizard" model="ir.actions.act_window">
        <field name="name">Configuración Seguros</field>
        <field name="res_model">rehalife.seguros.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_rehalife_seguros_sync_wizard_form"/>
        <field name="target">inline</field>
    </record>

</odoo>

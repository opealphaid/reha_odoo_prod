<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_accountentry_migracion" model="report.paperformat">
            <field name="name">Latinamerican Letter</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">43</field>
            <field name="dpi">90</field>
        </record>

        <record id="accountentry_migracion" model="ir.actions.report">
            <field name="name">Asiento Contable Migración</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">accounting_community.accountentry_migracion_template</field>
            <field name="report_file">accounting_community.accountentry_migracion_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="accounting_community.paperformat_accountentry_migracion"/>
        </record>

    </data>
</odoo>

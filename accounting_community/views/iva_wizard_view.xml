<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form view -->
    <record id="view_iva_wizard_form" model="ir.ui.view">
        <field name="name">accounting_community.iva.wizard.form</field>
        <field name="model">accounting_community.iva.wizard</field>
        <field name="arch" type="xml">
            <form string="Libro de Compras y Ventas IVA">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_print_sales_iva"
                            string="Libro Ventas"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_purchase_iva"
                            string="Libro Compras"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_iva_wizard" model="ir.actions.act_window">
        <field name="name">Libro de Compras y Ventas IVA</field>
        <field name="res_model">accounting_community.iva.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_iva_wizard_form"/>
    </record>

    <!-- Menu item (reutiliza el root ya creado por bankbook) -->
    <menuitem
        id="menu_iva_report"
        name="Libro de Compras y Ventas IVA"
        parent="menu_accounting_community_root"
        action="action_iva_wizard"
        sequence="5"
    />
</odoo>

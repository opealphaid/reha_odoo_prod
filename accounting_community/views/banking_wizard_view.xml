<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form view -->
    <record id="view_banking_wizard_form" model="ir.ui.view">
        <field name="name">accounting_community.banking.wizard.form</field>
        <field name="model">accounting_community.banking.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Bancarización">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_print_sales_banking"
                            string="Generar Reporte Ventas"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_purchase_banking"
                            string="Generar Reporte Compras"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_banking_wizard" model="ir.actions.act_window">
        <field name="name">Bancarización</field>
        <field name="res_model">accounting_community.banking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_banking_wizard_form"/>
    </record>

    <!-- Menu items (reutiliza el root ya creado por bankbook) -->
    <menuitem
        id="menu_banking_report"
        name="Bancarización"
        parent="menu_accounting_community_root"
        action="action_banking_wizard"
        sequence="20"
    />
</odoo>
